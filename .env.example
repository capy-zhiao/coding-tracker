# Settings for docker compose. Copy to .env (gitignored) and edit. For running without
# Docker, see backend/.env.example, which documents every setting.

# ---- Address ----
# A domain gets HTTPS automatically (its DNS must already point here, ports 80/443 open).
# ":80" is plain HTTP, for trying it on your own machine.
SITE_ADDRESS=:80
# What people type into the browser, without a trailing slash
PUBLIC_BASE_URL=http://localhost
# Host ports, if 80/443 are taken locally
HTTP_PORT=80
HTTPS_PORT=443

# ---- Database ----
# Any long random string: python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=change-me

# ---- Accounts ----
# "local": no login, one user. Fine on your own machine; never on a public server.
# "github": sign in with GitHub. Needs the four settings below.
AUTH_MODE=local
SESSION_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OWNER_GITHUB_LOGIN=
# A "Try the demo" button with a shared, daily rebuilt account (github mode only)
DEMO_ENABLED=false

# Which time zone the server's "today" uses for anyone who hasn't picked their own
TIMEZONE=America/Toronto

# ---- AI (the owner's key; everyone else brings their own in Settings) ----
LLM_PROVIDER=none
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
ANTHROPIC_API_KEY=

# Daily queue limits for anyone who hasn't set their own
DAILY_REVIEW_CAP=4
DAILY_NEW_CAP=3
