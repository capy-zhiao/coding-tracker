# Settings for docker compose. Copy to .env (gitignored) and edit; every value here is a
# placeholder. For running without Docker, use backend/.env.example instead.
# The database is fixed to the tracker-data volume by docker-compose.yml.

# Which timezone defines "today". Containers run in UTC, so set this, or an evening
# session is filed under the next day.
TIMEZONE=America/Toronto

# Host port for the web app: http://localhost:8080
WEB_PORT=8080

# ---- LLM provider (optional) ----
# "none" keeps every feature except the AI ones; the app works fully without a key.
LLM_PROVIDER=none
# If LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key
# If LLM_PROVIDER=deepseek (any OpenAI-compatible endpoint)
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# ---- Access control ----
# When API_KEY is set, the backend rejects requests without a matching X-API-Key header,
# and the frontend must be built with the same value in VITE_API_KEY. VITE_API_KEY is
# compiled into the JavaScript, so anyone who can open the page can read it: treat it
# as a shared access token, not a secret, and restrict who can reach the server.
API_KEY=
VITE_API_KEY=

# Daily queue limits (see backend/.env.example for the rest)
DAILY_REVIEW_CAP=4
DAILY_NEW_CAP=3
