# Local dev uses SQLite — zero setup. For production, switch to Postgres:
#   DATABASE_URL=postgresql+psycopg://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///./tracker.db

# ---- LLM provider for mock-interview follow-ups and AI code review ----
# Options: "none" (disable AI features) | "anthropic" | "deepseek"
LLM_PROVIDER=none

# If LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# If LLM_PROVIDER=deepseek  (OpenAI-compatible API)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Optional cheaper model for the complexity check (empty = DEEPSEEK_MODEL)
DEEPSEEK_COMPLEXITY_MODEL=
# Thinking mode (DeepSeek default: on). Reasoning tokens are billed as output tokens.
DEEPSEEK_THINKING=true
DEEPSEEK_REASONING_EFFORT=high

# "local" (default): no login, all data belongs to one local user.
# "github": sign in with GitHub, one account per person. Then also set:
#   PUBLIC_BASE_URL       the address people open, e.g. https://leetcode.example.dev
#   SESSION_SECRET        32+ characters: python -c "import secrets; print(secrets.token_urlsafe(48))"
#   GITHUB_CLIENT_ID / GITHUB_CLIENT_SECRET   from a GitHub OAuth app whose callback URL
#                         is {PUBLIC_BASE_URL}/api/auth/callback/github
#   OWNER_GITHUB_LOGIN    your GitHub username: that account uses the LLM key above
#   DEMO_ENABLED=true     adds "Try the demo": a shared account with generated history,
#                         rebuilt every day
AUTH_MODE=local

# Daily queue limits
DAILY_REVIEW_CAP=4
DAILY_NEW_CAP=3
# Interleaving: at most N reviews per chapter / per pattern each day (0 = no limit).
# Empty slots are always backfilled, so this never shrinks the day.
DAILY_PER_CHAPTER_CAP=2
DAILY_PER_PATTERN_CAP=2
# New problems: 0 = strict tier order; raise to spread a day across chapters / patterns.
DAILY_NEW_PER_CHAPTER_CAP=0
DAILY_NEW_PER_PATTERN_CAP=0
NEW_HARD_LAST=true
# Finish the NeetCode 150 before the 250 additions (which then come shuffled).
NEW_NEETCODE150_FIRST=true
# NeetCode 150 chapters that wait with the 250 additions (17 = Bit, 18 = Math).
NEW_LATER_CHAPTERS=17,18

# Which timezone defines "today". Empty = the machine's local zone, which is usually
# right. Set it explicitly when deploying to a server that runs in UTC, otherwise an
# evening session would be filed under the next day and the streak would break.
#   TIMEZONE=America/Toronto
TIMEZONE=
