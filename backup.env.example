# Nightly backups. Copy to backup.env (gitignored). Only the backup container reads this
# file, so the S3 credentials never reach the app.
#
# Without a bucket, the last 3 dumps stay on the "backups" volume only.
BACKUP_BUCKET=
AWS_REGION=ca-central-1
# An IAM user allowed only s3:PutObject on <bucket>/leetcode-tracker/*. Leave these empty
# when the EC2 instance has an IAM role with that permission instead (then the
# instance's metadata hop limit has to be 2 for a container to reach it).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# cron syntax, UTC
BACKUP_SCHEDULE=15 3 * * *
